# Terraform state and plans (may contain secrets)
*.tfstate
*.tfstate.*
*.tfplan
plan.tfplan
*.plan

# Provider / plugin cache
.terraform/
.terraform.lock.hcl

# Override files (local overrides, may contain secrets)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config
.terraformrc
terraform.rc

# Variables (may contain secrets)
*.tfvars
*.tfvars.json
